---
import { ViewTransitions } from 'astro:transitions';
import SEOHead from '../components/seo/SEOHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import '../styles/global.css';
import '../styles/animations.css';
import type { SEOInput } from '../lib/seo';

interface Props extends SEOInput {}

const props = Astro.props;
const basePath = import.meta.env.BASE_URL === '/'
  ? ''
  : import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted fonts — swap paths once real .woff2 files are added to /public/fonts -->
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face {
        font-family: 'Instrument Sans';
        src: url('/fonts/instrument-sans.woff2') format('woff2');
        font-weight: 400 700;
        font-display: swap;
      }
      @font-face {
        font-family: 'Space Mono';
        src: url('/fonts/space-mono.woff2') format('woff2');
        font-weight: 400 700;
        font-display: swap;
      }
    </style>

    <SEOHead {...props} />
    <StructuredData />
    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-accent-fg focus:px-4 focus:py-2 focus:rounded-md">
      Skip to content
    </a>
    <slot />
    <script define:vars={{ basePath }}>
      // Content links are authored as root-relative paths for the custom domain.
      // Prefix them at runtime when this static build is served from a GitHub
      // Pages project URL such as /personal_portfolio/.
      const applyBasePathToInternalLinks = () => {
        if (!basePath) return;

        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href || href.startsWith('//') || href.startsWith(`${basePath}/`)) return;
          link.setAttribute('href', `${basePath}${href}`);
        });
      };

      applyBasePathToInternalLinks();
      document.addEventListener('astro:after-swap', applyBasePathToInternalLinks);
    </script>
  </body>
</html>
