---
import { FOOTER_NAV } from '../../data/nav';
import { SITE } from '../../data/site';
---

<footer class="border-t border-white/10 mt-32">
  <div class="mx-auto max-w-content px-6 py-16 grid gap-12 lg:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <p class="font-display text-lg text-fg">Prajjwal Sharma</p>
      <p class="mt-3 max-w-sm text-sm text-muted">
        AI-enabled business professional working across strategy, growth marketing, and operations —
        based in {SITE.location}.
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="text-xs uppercase tracking-wider text-muted mb-4">Site</p>
      <ul class="space-y-2">
        {FOOTER_NAV.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-muted hover:text-fg transition-colors">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="text-xs uppercase tracking-wider text-muted mb-4">Connect</p>
      <ul class="space-y-2">
        <li><a href={`mailto:${SITE.socials.email}`} class="text-sm text-muted hover:text-fg transition-colors">Email</a></li>
        <li><a href={SITE.socials.linkedin} class="text-sm text-muted hover:text-fg transition-colors">LinkedIn</a></li>
        <li><a href={SITE.socials.github} class="text-sm text-muted hover:text-fg transition-colors">GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div class="mx-auto max-w-content px-6 py-6 flex flex-col sm:flex-row gap-2 justify-between text-xs text-muted">
      <p>&copy; {new Date().getFullYear()} Prajjwal Sharma. All rights reserved.</p>
      <p>Built with Astro.</p>
    </div>
  </div>
</footer>
