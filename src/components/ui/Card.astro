---
import { cn } from '../../lib/utils';

interface Props {
  href?: string;
  class?: string;
  hover?: boolean;
  target?: '_blank';
}

const { href, class: className, hover = true, target } = Astro.props;
const Tag = href ? 'a' : 'div';

const classes = cn(
  'block rounded-lg border border-white/10 bg-surface p-6 transition-all duration-300 ease-out-quart',
  hover && 'hover:border-white/20 hover:-translate-y-1 hover:shadow-lg',
  className,
);
---

<Tag href={href} class={classes} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
  <slot />
</Tag>
