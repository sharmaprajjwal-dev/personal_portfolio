---
import { cn } from '../../lib/utils';

interface Props {
  as?: 'span' | 'button';
  active?: boolean;
  class?: string;
}

const { as = 'span', active = false, class: className } = Astro.props;
const Tag = as;
---

<Tag
  class={cn(
    'inline-flex items-center rounded-md px-3 py-1.5 text-xs font-mono transition-colors duration-200',
    active ? 'bg-fg text-bg' : 'bg-transparent border border-white/10 text-muted hover:text-fg hover:border-white/20',
    className,
  )}
>
  <slot />
</Tag>
