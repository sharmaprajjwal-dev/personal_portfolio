---
import { cn } from '../../lib/utils';

interface Props {
  eyebrow?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, align = 'left', class: className } = Astro.props;
---

<div class={cn('max-w-2xl', align === 'center' && 'mx-auto text-center', className)}>
  {eyebrow && (
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-4">{eyebrow}</p>
  )}
  <h2 class="text-balance text-3xl sm:text-4xl font-display font-semibold text-fg">
    <slot />
  </h2>
  {Astro.slots.has('description') && (
    <div class="mt-4 text-muted text-base sm:text-lg">
      <slot name="description" />
    </div>
  )}
</div>
