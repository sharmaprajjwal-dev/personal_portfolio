---
// One of the 4 components allowed to carry client-side JS (see README / architecture doc).
// Filters sibling nodes within `targetSelector` by matching a `data-tags` attribute
// against the active tag. Framework-free — plain DOM, same pattern as Reveal.astro.
import { cn } from '../../lib/utils';

interface Props {
  tags: string[];
  targetSelector: string; // e.g. '[data-filter-grid] > [data-tags]'
  class?: string;
}

const { tags, targetSelector, class: className } = Astro.props;
const groupId = `filter-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={cn('flex flex-wrap gap-2', className)} data-filter-tabs data-target={targetSelector} role="group" aria-label="Filter by tag">
  <button type="button" data-filter-tab data-tag="all" aria-pressed="true"
    class="inline-flex items-center rounded-md border border-white/10 bg-fg px-3 py-1.5 text-xs font-mono text-bg transition-colors duration-200"
  >
    All
  </button>
  {tags.map((tag) => (
    <button type="button" data-filter-tab data-tag={tag} aria-pressed="false"
      class="inline-flex items-center rounded-md border border-white/10 bg-transparent px-3 py-1.5 text-xs font-mono text-muted transition-colors duration-200 hover:text-fg hover:border-white/20"
    >
      {tag}
    </button>
  ))}
</div>

<script>
  function setupFilterTabs() {
    document.querySelectorAll<HTMLElement>('[data-filter-tabs]').forEach((group) => {
      const targetSelector = group.dataset.target;
      if (!targetSelector || group.dataset.bound === 'true') return;
      group.dataset.bound = 'true';

      const items = Array.from(document.querySelectorAll<HTMLElement>(targetSelector));
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter-tab]'));

      const activate = (tab: HTMLButtonElement) => {
        const tag = tab.dataset.tag ?? 'all';

        tabs.forEach((t) => {
          const isActive = t === tab;
          t.setAttribute('aria-pressed', String(isActive));
          t.classList.toggle('bg-fg', isActive);
          t.classList.toggle('text-bg', isActive);
          t.classList.toggle('bg-transparent', !isActive);
          t.classList.toggle('text-muted', !isActive);
        });

        items.forEach((item) => {
          const itemTags = (item.dataset.tags ?? '').split(',').filter(Boolean);
          const show = tag === 'all' || itemTags.includes(tag);
          item.style.display = show ? '' : 'none';
        });
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab)));
    });
  }

  setupFilterTabs();
  document.addEventListener('astro:page-load', setupFilterTabs);
</script>
