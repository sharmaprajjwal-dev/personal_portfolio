---
import { cn } from '../../lib/utils';

interface Props {
  label: string;
  name: string;
  required?: boolean;
  placeholder?: string;
  rows?: number;
  class?: string;
}

const { label, name, required = false, placeholder, rows = 5, class: className } = Astro.props;
---

<div class={cn(className)}>
  <label for={name} class="mb-2 block text-sm text-muted">{label}</label>
  <textarea
    id={name}
    name={name}
    required={required}
    placeholder={placeholder}
    rows={rows}
    class="w-full resize-y rounded-md border border-white/10 bg-surface px-4 py-3 text-sm text-fg placeholder:text-muted/50 transition-colors duration-200 ease-out-quart focus:border-accent/50 focus-visible:outline-none"
  ></textarea>
</div>
