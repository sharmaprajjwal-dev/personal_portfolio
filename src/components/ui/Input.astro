---
import { cn } from '../../lib/utils';

interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel';
  required?: boolean;
  placeholder?: string;
  class?: string;
}

const { label, name, type = 'text', required = false, placeholder, class: className } = Astro.props;
---

<div class={cn(className)}>
  <label for={name} class="mb-2 block text-sm text-muted">{label}</label>
  <input
    id={name}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    class="w-full rounded-md border border-white/10 bg-surface px-4 py-3 text-sm text-fg placeholder:text-muted/50 transition-colors duration-200 ease-out-quart focus:border-accent/50 focus-visible:outline-none"
  />
</div>
