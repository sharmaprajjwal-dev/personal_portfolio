---
import Reveal from '../ui/Reveal.astro';
import Divider from '../ui/Divider.astro';
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-content">
    <Divider withNode />
    <Reveal>
      <p class="mt-16 max-w-3xl text-balance font-display text-2xl font-medium leading-snug text-fg sm:text-3xl">
        Most people treat business strategy, marketing execution, and AI as three separate
        skill sets. I use them as one system —
        <span class="text-accent">strategy defines what to build, marketing gets it in front
        of the right people, and AI removes the friction between the two.</span>
      </p>
    </Reveal>
  </div>
</section>
