---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section class="relative overflow-hidden px-6 pt-20 pb-28 sm:pt-28 sm:pb-36">
  <div class="node-grid node-grid-fade absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-content">
    <div class="animate-reveal-up" style="animation-delay: 0ms">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
        AI-Enabled Business Professional
      </p>
    </div>

    <h1
      class="animate-reveal-up mt-6 max-w-4xl text-balance font-display text-5xl font-semibold leading-[1.05] text-fg sm:text-6xl lg:text-7xl"
      style="animation-delay: 80ms"
    >
      I solve business problems through structured thinking, digital strategy, and AI.
    </h1>

    <p
      class="animate-reveal-up mt-8 max-w-xl text-lg text-muted sm:text-xl"
      style="animation-delay: 160ms"
    >
      Six years across strategy, growth marketing, and operations — now applying AI to make
      each of those functions faster, sharper, and easier to scale.
    </p>

    <div class="animate-reveal-up mt-10 flex flex-wrap items-center gap-4" style="animation-delay: 240ms">
      <Button href="/resume">
        View resume
        <Icon name="arrow-right" size={16} />
      </Button>
      <Button href="/case-studies" variant="secondary">See case studies</Button>
    </div>

    <div class="animate-reveal-up mt-16 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/10 pt-8" style="animation-delay: 320ms">
      <div>
        <p class="font-mono text-2xl text-fg">6+</p>
        <p class="text-sm text-muted">Years in strategy &amp; growth</p>
      </div>
      <div>
        <p class="font-mono text-2xl text-fg">MBA</p>
        <p class="text-sm text-muted">Business foundation</p>
      </div>
      <div>
        <p class="font-mono text-2xl text-fg">3</p>
        <p class="text-sm text-muted">Countries — Nepal, UAE &amp; New Zealand</p>
      </div>
    </div>
  </div>
</section>
