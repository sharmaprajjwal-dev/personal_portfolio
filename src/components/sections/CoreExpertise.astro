---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { CORE_EXPERTISE } from '../../data/skills';
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-content">
    <SectionHeading eyebrow="What I do">Core expertise</SectionHeading>

    <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {CORE_EXPERTISE.map((item, i) => (
        <Reveal delay={i * 80} class="bg-surface p-8">
          <p class="font-mono text-xs text-accent">0{i + 1}</p>
          <h3 class="mt-4 font-display text-lg text-fg">{item.title}</h3>
          <p class="mt-2 text-sm text-muted">{item.description}</p>
        </Reveal>
      ))}
    </div>
  </div>
</section>
