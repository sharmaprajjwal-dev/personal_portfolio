---
import SectionHeading from '../ui/SectionHeading.astro';
import CaseStudyCard from '../cards/CaseStudyCard.astro';
import Reveal from '../ui/Reveal.astro';
import { getFeaturedCaseStudy } from '../../lib/collections';

const caseStudy = await getFeaturedCaseStudy();
---

{caseStudy && (
  <section class="px-6 py-24 sm:py-32">
    <div class="mx-auto max-w-content">
      <SectionHeading eyebrow="Case study">Impact, not just activity</SectionHeading>
      <div class="mt-12">
        <Reveal>
          <CaseStudyCard caseStudy={caseStudy} />
        </Reveal>
      </div>
    </div>
  </section>
)}
