---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';

const principles = [
  {
    title: 'Structure before speed',
    body: 'A clear framework beats a fast guess. I map the problem before touching a single ad, script, or line of copy.',
  },
  {
    title: 'AI as leverage, not shortcut',
    body: 'AI removes repetitive work so more time goes into judgment calls — not the other way around.',
  },
  {
    title: 'Measured, not just launched',
    body: 'Every campaign, page, and workflow ships with a way to know if it actually worked.',
  },
];
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-content">
    <SectionHeading eyebrow="How I work">Business philosophy</SectionHeading>

    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {principles.map((p, i) => (
        <Reveal delay={i * 80}>
          <div class="border-l-2 border-accent/40 pl-6">
            <h3 class="font-display text-lg text-fg">{p.title}</h3>
            <p class="mt-3 text-sm text-muted">{p.body}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
