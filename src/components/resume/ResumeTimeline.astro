---
import { getExperienceTimeline } from '../../lib/collections';
import { formatMonthYear } from '../../lib/utils';

const timeline = await getExperienceTimeline();
---

<div class="relative">
  <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/10" aria-hidden="true"></div>

  <ol class="space-y-12">
    {timeline.map((role) => (
      <li class="relative pl-10">
        <span class="absolute left-0 top-1.5 h-3.5 w-3.5 rounded-full border-2 border-accent bg-bg"></span>

        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="font-display text-xl text-fg">{role.data.role}</h3>
          <p class="font-mono text-xs text-muted">
            {formatMonthYear(role.data.startDate)} — {role.data.endDate ? formatMonthYear(role.data.endDate) : 'Present'}
          </p>
        </div>
        <p class="text-sm text-accent">{role.data.company}</p>

        <ul class="mt-4 space-y-2">
          {role.data.bullets.map((bullet) => (
            <li class="flex gap-3 text-sm text-muted">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-muted"></span>
              {bullet}
            </li>
          ))}
        </ul>

        {role.data.stack.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {role.data.stack.map((tech) => (
              <span class="rounded-md border border-white/10 px-2.5 py-1 font-mono text-xs text-muted">
                {tech}
              </span>
            ))}
          </div>
        )}
      </li>
    ))}
  </ol>
</div>
