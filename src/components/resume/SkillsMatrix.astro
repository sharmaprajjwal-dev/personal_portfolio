---
import { SKILLS_MATRIX } from '../../data/skills';
---

<div class="grid gap-10 sm:grid-cols-3">
  {SKILLS_MATRIX.map((group) => (
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-muted">{group.category}</h3>
      <ul class="mt-5 space-y-4">
        {group.skills.map((skill) => (
          <li>
            <div class="flex items-baseline justify-between">
              <span class="text-sm text-fg">{skill.name}</span>
              <span class="font-mono text-xs text-muted">{skill.level}</span>
            </div>
            <div class="mt-1.5 h-1 w-full rounded-full bg-white/10">
              <div
                class="h-1 rounded-full bg-accent"
                style={`width: ${skill.level}%`}
              ></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
