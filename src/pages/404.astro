---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
---

<PageLayout title="Page not found" description="The page you're looking for doesn't exist.">
  <div class="mx-auto max-w-content px-6 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-6">404</p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold text-fg text-balance">
      This page took a different path.
    </h1>
    <p class="mt-4 text-muted max-w-md mx-auto">
      The page you're looking for doesn't exist, or has moved.
    </p>
    <div class="mt-8">
      <Button href="/">Back to home</Button>
    </div>
  </div>
</PageLayout>
