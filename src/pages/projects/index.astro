---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CompanyCard from '../../components/cards/CompanyCard.astro';
import FilterTabs from '../../components/ui/FilterTabs.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { getPublishedProjects } from '../../lib/collections';

const projects = await getPublishedProjects();
const industries = [...new Set(projects.map((p) => p.data.industry))].sort();
---

<PageLayout
  title="Projects"
  description="Consulting engagements across strategy, growth, and applied AI — one company, one story, one set of deliverables at a time."
  canonicalPath="/projects"
>
  <section class="px-6 pt-8 pb-12">
    <div class="mx-auto max-w-content">
      <Reveal>
        <SectionHeading eyebrow="Selected work">
          Projects
          <Fragment slot="description">
            A working record of the businesses I've worked with — the challenge, the approach,
            and every deliverable that came out of it.
          </Fragment>
        </SectionHeading>
      </Reveal>

      {industries.length > 1 && (
        <Reveal delay={80} class="mt-10">
          <FilterTabs tags={industries} targetSelector="[data-project-grid] > [data-tags]" />
        </Reveal>
      )}
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-content">
      {projects.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
          {projects.map((project, i) => (
            <div data-tags={project.data.industry} class="contents">
              <Reveal delay={Math.min(i, 5) * 80}>
                <CompanyCard project={project} />
              </Reveal>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-muted">Projects are being added — check back soon.</p>
      )}
    </div>
  </section>
</PageLayout>
