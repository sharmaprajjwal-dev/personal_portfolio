---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import FilterTabs from '../../components/ui/FilterTabs.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { getPublishedArticles } from '../../lib/collections';

const articles = await getPublishedArticles();
const categories = [...new Set(articles.map((a) => a.data.category))].sort();
---

<PageLayout
  title="Research"
  description="Research and analysis on AI, business strategy, and digital growth — written by Prajjwal Sharma."
  canonicalPath="/research"
>
  <section class="px-6 pt-8 pb-12">
    <div class="mx-auto max-w-content">
      <Reveal>
        <SectionHeading eyebrow="Writing">
          Research
          <Fragment slot="description">
            Longer-form thinking on where AI actually earns its keep in business — plus the
            strategy and growth ideas that sit underneath it.
          </Fragment>
        </SectionHeading>
      </Reveal>

      {categories.length > 1 && (
        <Reveal delay={80} class="mt-10">
          <FilterTabs tags={categories} targetSelector="[data-article-grid] > [data-tags]" />
        </Reveal>
      )}
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-content">
      {articles.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-article-grid>
          {articles.map((article, i) => (
            <div data-tags={article.data.category} class="contents">
              <Reveal delay={Math.min(i, 5) * 80}>
                <ArticleCard article={article} />
              </Reveal>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-muted">Research articles are being added — check back soon.</p>
      )}
    </div>
  </section>
</PageLayout>
