---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import GlassPanel from '../components/ui/GlassPanel.astro';
import Card from '../components/ui/Card.astro';
import Icon from '../components/ui/Icon.astro';
import Reveal from '../components/ui/Reveal.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { SITE } from '../data/site';

const links = [
  {
    label: 'WhatsApp',
    hint: 'Fastest way to reach me',
    href: SITE.socials.whatsapp,
    icon: 'chat-bubble' as const,
  },
  {
    label: 'LinkedIn',
    hint: 'Professional background & posts',
    href: SITE.socials.linkedin,
    icon: 'linkedin' as const,
  },
  {
    label: 'GitHub',
    hint: 'Code & project history',
    href: SITE.socials.github,
    icon: 'github' as const,
  },
  {
    label: 'Email',
    hint: SITE.socials.email,
    href: `mailto:${SITE.socials.email}`,
    icon: 'mail' as const,
  },
];
---

<PageLayout
  title="Contact"
  description="Get in touch with Prajjwal Sharma — WhatsApp, LinkedIn, GitHub, or send an inquiry directly."
  canonicalPath="/contact"
>
  <section class="px-6 pt-8 pb-12">
    <div class="mx-auto max-w-content">
      <Reveal>
        <SectionHeading eyebrow="Get in touch">
          Contact
          <Fragment slot="description">
            Reach out directly, or send an inquiry below — either way, I'll get back to you
            quickly.
          </Fragment>
        </SectionHeading>
      </Reveal>
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-content grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <Reveal class="space-y-4">
        {links.map((link) => (
          <Card href={link.href} target={link.icon !== 'mail' ? '_blank' : undefined} class="flex items-center gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-white/10 bg-surface-raised text-accent">
              <Icon name={link.icon} size={18} />
            </span>
            <span>
              <span class="block font-display text-fg">{link.label}</span>
              <span class="block text-sm text-muted">{link.hint}</span>
            </span>
          </Card>
        ))}
      </Reveal>

      <Reveal delay={80}>
        <GlassPanel class="p-8 sm:p-10">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Send an inquiry</p>
          <h2 class="mt-3 font-display text-2xl text-fg">Tell me what you need</h2>
          <div class="mt-8">
            <ContactForm />
          </div>
        </GlassPanel>
      </Reveal>
    </div>
  </section>
</PageLayout>
