---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { SITE } from '../../data/site';
---

<PageLayout
  title="Prompt Library"
  description="A working collection of AI prompts by Prajjwal Sharma, covering business, marketing, SEO, research, and automation."
  canonicalPath="/prompt-library"
>
  <section class="relative overflow-hidden px-6 py-24 sm:py-32">
    <div class="node-grid absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="mx-auto max-w-content">
      <Reveal>
        <SectionHeading eyebrow="Applied AI" align="center" class="mx-auto">
          Prompt Library
          <Fragment slot="description">
            A growing, working collection of prompts across business, marketing, SEO,
            research, and automation — kept in one shared folder so it's easy to browse,
            copy, and reuse.
          </Fragment>
        </SectionHeading>
      </Reveal>

      <Reveal delay={100}>
        <GlassPanel class="mx-auto mt-12 max-w-lg p-10 text-center">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Full library</p>
          <p class="mt-4 text-muted">
            Browse the complete, up-to-date collection of prompts in the shared Google Drive
            folder.
          </p>
          <div class="mt-8 flex justify-center">
            <Button href={SITE.promptLibraryDriveUrl} size="md" target="_blank">
              Open prompt library
              <Icon name="arrow-up-right" size={16} />
            </Button>
          </div>
        </GlassPanel>
      </Reveal>
    </div>
  </section>
</PageLayout>
