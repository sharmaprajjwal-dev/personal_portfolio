---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { SITE } from '../../data/site';
---

<PageLayout
  title="Gallery"
  description="Creative work by Prajjwal Sharma — design, campaigns, and visual work."
  canonicalPath="/gallery"
>
  <section class="relative overflow-hidden px-6 py-24 sm:py-32">
    <div class="node-grid absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="mx-auto max-w-content">
      <Reveal>
        <SectionHeading eyebrow="Visual work" align="center" class="mx-auto">
          Gallery
          <Fragment slot="description">
            A running collection of creative and design work — campaigns, websites,
            infographics, and photography — kept in one shared folder so it's easy to
            browse in full resolution.
          </Fragment>
        </SectionHeading>
      </Reveal>

      <Reveal delay={100}>
        <GlassPanel class="mx-auto mt-12 max-w-lg p-10 text-center">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Full gallery</p>
          <p class="mt-4 text-muted">
            View the complete, up-to-date set of work in the shared Google Drive folder.
          </p>
          <div class="mt-8 flex justify-center">
            <Button href={SITE.galleryDriveUrl} size="md" target="_blank">
              Open gallery
              <Icon name="arrow-up-right" size={16} />
            </Button>
          </div>
        </GlassPanel>
      </Reveal>
    </div>
  </section>
</PageLayout>
