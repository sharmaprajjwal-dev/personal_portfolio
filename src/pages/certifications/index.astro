---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { formatMonthYear } from '../../lib/utils';
import { getCertifications } from '../../lib/collections';

const certifications = await getCertifications();
---

<PageLayout
  title="Certifications"
  description="Certifications earned by Prajjwal Sharma."
  canonicalPath="/certifications"
>
  <section class="px-6 pt-8 pb-12">
    <div class="mx-auto max-w-content">
      <Reveal>
        <SectionHeading eyebrow="Credentials">Certifications</SectionHeading>
      </Reveal>
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-content">
      {certifications.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {certifications.map((cert, i) => {
            const { title, institution, issueDate, credentialUrl, image } = cert.data;
            return (
              <Reveal delay={Math.min(i, 5) * 80}>
                <Card href={credentialUrl} hover={Boolean(credentialUrl)} class="h-full">
                  {image && (
                    <div class="mb-5 aspect-video overflow-hidden rounded-md border border-white/10">
                      <Image
                        src={image}
                        inferSize
                        alt={`${title} badge`}
                        class="h-full w-full object-cover"
                      />
                    </div>
                  )}
                  <p class="font-mono text-xs uppercase tracking-wider text-muted">{institution}</p>
                  <h3 class="mt-3 font-display text-lg text-fg">{title}</h3>
                  <div class="mt-4 flex items-center justify-between">
                    <time datetime={issueDate.toISOString()} class="font-mono text-xs text-muted">
                      {formatMonthYear(issueDate)}
                    </time>
                    {credentialUrl && (
                      <Icon name="arrow-up-right" size={14} class="text-muted" />
                    )}
                  </div>
                </Card>
              </Reveal>
            );
          })}
        </div>
      ) : (
        <p class="text-muted">Certifications are being added — check back soon.</p>
      )}
    </div>
  </section>
</PageLayout>
